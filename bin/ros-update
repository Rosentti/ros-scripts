#!/usr/bin/env bash
set -e

if [ -z "$ROS_NIXOS_CFG_SOURCE" ]; then
    echo "ROS_NIXOS_CFG_SOURCE is empty"
    exit 1
fi

if [ -z "$ROS_NIXOS_CFG_TARGET" ]; then
    echo "ROS_NIXOS_CFG_TARGET is empty"
    exit 1
fi

hostname=$(hostname)
if [[ $# -lt 1 ]]; then
    echo "ros-update: <label-with-dashes-only>"
    exit 1
fi

if [[ $1 = *" "* ]]; then
    echo "invalid label, can't use spaces"
    exit 2
fi

if [[ $1 = *"'"* ]]; then
    echo "invalid label, can't use single quote"
    exit 2
fi

if [[ $1 = *"\""* ]]; then
    echo "invalid label, can't use quote"
    exit 2
fi

cd "$ROS_NIXOS_CFG_SOURCE"

if [ ! -f "$hostname.nix" ]; then
    echo "Config not found for this host! Looked for '$ROS_NIXOS_CFG_SOURCE/$hostname.nix'"
    exit 3
fi

# copy the hw config into a "safe" place (this feels very wrong)
sudo cp "$ROS_NIXOS_CFG_TARGET/hardware-configuration.nix" /tmp/hw-config.nix

# This seems a bit risky but it's probably fine (don't @ me if this destroys your root)
sudo rm -rf "$ROS_NIXOS_CFG_TARGET"/*
sudo cp /tmp/hw-config.nix "$ROS_NIXOS_CFG_TARGET/hardware-configuration.nix"

sudo cp -R ./* "$ROS_NIXOS_CFG_TARGET"
sudo ln -sf "$hostname.nix" "$ROS_NIXOS_CFG_TARGET/configuration.nix"
sudo chown -R root:root "$ROS_NIXOS_CFG_TARGET"
sudo chmod -R 664 "$ROS_NIXOS_CFG_TARGET"
sudo env NIXOS_LABEL="$1" nixos-rebuild switch

echo "build success!"
git add --all
git commit -m "$1"
git push
